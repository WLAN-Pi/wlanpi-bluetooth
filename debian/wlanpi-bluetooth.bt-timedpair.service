[Unit]
Description=Bluetooth Pair Agent
 
[Service]
ExecStart=/bin/sh -ec 'a=$(/usr/bin/wlanpi-bt-adapter); \
    /usr/bin/bt-adapter -a "$$a" --set PairableTimeout 30; \
    /usr/bin/bt-adapter -a "$$a" --set DiscoverableTimeout 30; \
    /usr/bin/bt-adapter -a "$$a" --set Pairable 1; \
    /usr/bin/bt-adapter -a "$$a" --set Discoverable 1'
Type=oneshot
