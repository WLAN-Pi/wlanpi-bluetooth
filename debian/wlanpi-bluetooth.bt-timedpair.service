[Unit]
Description=Bluetooth Pair Agent
 
[Service]
ExecStart=/bin/sh -c '/usr/bin/bt-adapter -a "$(/usr/bin/wlanpi-bt-adapter)" --set PairableTimeout 30'
ExecStart=/bin/sh -c '/usr/bin/bt-adapter -a "$(/usr/bin/wlanpi-bt-adapter)" --set DiscoverableTimeout 30'
ExecStart=/bin/sh -c '/usr/bin/bt-adapter -a "$(/usr/bin/wlanpi-bt-adapter)" --set Pairable 1'
ExecStart=/bin/sh -c '/usr/bin/bt-adapter -a "$(/usr/bin/wlanpi-bt-adapter)" --set Discoverable 1'
Type=oneshot
