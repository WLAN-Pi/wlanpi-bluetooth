#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_install:
	dh_auto_install -- prefix=/usr

override_dh_installsystemd:
	dh_installsystemd --name=bt-agent
	dh_installsystemd --name=bt-network
	# Started on demand to open a pairing window; never enabled or started.
	dh_installsystemd --no-enable --no-start --name=bt-timedpair
